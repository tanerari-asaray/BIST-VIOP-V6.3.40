<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingVertical="6dp" android:paddingHorizontal="6dp" android:background="@drawable/bg_market_row" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/stockFavorite" style="@style/MarketText" android:text="@string/ui_label_b7927b5baee9" android:layout_width="48dp" android:layout_height="48dp" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" android:textSize="24sp" android:gravity="center" android:contentDescription="@string/ui_label_c1f494543af2"/>
        <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/stockSymbol" style="@style/MarketText" android:text="" android:textColor="@color/market_ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/stockCompany" style="@style/MarketText" android:text="" android:layout_width="match_parent" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/stockDirection" android:maxLines="2" android:ellipsize="end" style="@style/MarketText" android:text="" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <TextView android:id="@+id/stockMore" style="@style/MarketText" android:text="@string/ui_label_7bb37df5cb36" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:textSize="23sp" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="48dp" android:paddingEnd="48dp">
        <FrameLayout android:layout_width="58dp" android:layout_height="32dp">
            <tr.borsatakip.v5.ui.StockSparklineView android:id="@+id/stockMiniChart" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/stockMiniChartState" style="@style/MarketText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="12sp" android:background="@color/market_bg" android:visibility="gone"/>
        </FrameLayout>
        <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp">
            <TextView android:id="@+id/stockPrice" style="@style/MarketText" android:text="" android:layout_width="match_parent" android:gravity="end" android:textColor="@color/market_ink" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/stockChange" style="@style/MarketText" android:text="" android:layout_width="match_parent" android:gravity="end" android:textSize="12sp" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/stockVolume" style="@style/MarketText" android:text="" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
