    <TextView android:id="@+id/navViop" style="@style/NavItem" android:text="VİOP" android:drawableTop="@drawable/ic_sd_nav_viop" android:drawablePadding="4dp" />
    <TextView android:id="@+id/navFav" style="@style/NavItem" android:text="Favoriler" android:drawableTop="@drawable/ic_sd_nav_fav" android:drawablePadding="4dp" />
