<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_label_26ea918c1c58"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viopDetailSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout android:baselineAligned="false"
                android:id="@+id/viopPriceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_viop_terminal_card"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/viopDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viopDetailChange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/text_secondary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/viopDataState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_label_c56311a11c88"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viopVolume"
                        style="@style/Sub"
                        android:layout_marginTop="8dp"
                        android:text="@string/ui_label_b9e101f69936" />

                    <TextView
                        android:id="@+id/viopOpenInterest"
                        style="@style/Sub"
                        android:layout_marginTop="3dp"
                        android:text="@string/ui_label_efd58f08cc2e" />

                    <TextView
                        android:id="@+id/viopDataAge"
                        style="@style/MetricLabel"
                        android:layout_marginTop="5dp"
                        android:text="@string/ui_label_fba963be39dd" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/viopDetailStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/viopTabChart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_viop_terminal_tab_selected"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/ui_label_7f8147ac93bc"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/viopTabDepth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_viop_terminal_tab"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/ui_label_fc1fb2652693"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/viopTabSignal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_viop_terminal_tab"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/ui_label_e1442244ab11"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/viopTabContract"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_viop_terminal_tab"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/ui_label_9f6f33b35bd3"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viopGraphSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_label_ac284c4a61a3"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <Button android:id="@+id/viopTf1m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_065387c96358" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf3m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_fcffba982815" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf5m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab_selected" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_ca3de0f736ed" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf15m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_6b66e5f638cf" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf1h" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_2ae52edcbeaa" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf4h" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_dfea495b2079" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/viopTf1d" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_viop_terminal_tab" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/ui_label_663400d73362" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_viop_terminal_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/viopChartTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_label_ae5e8decbf26"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <tr.borsatakip.v5.ui.PriceChartView
                        android:id="@+id/viopPriceChart"
                        android:layout_width="match_parent"
                        android:layout_height="310dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/bg"
                        android:contentDescription="@string/ui_label_6b8a30835e2e"
                        android:padding="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_viop_terminal_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/SectionTitle" android:text="@string/ui_label_e07b35f4062c" />

                    <LinearLayout android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/MetricLabel" android:text="@string/ui_label_6a079fd187d2"/><TextView android:id="@+id/viopRsi" style="@style/MetricValue" android:text="@string/ui_label_bda050585a00"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/MetricLabel" android:text="@string/ui_label_5210ff85f7fa"/><TextView android:id="@+id/viopMacd" style="@style/MetricValue" android:text="@string/ui_label_bda050585a00"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/MetricLabel" android:text="@string/ui_label_d64d788b6b4a"/><TextView android:id="@+id/viopEma20" style="@style/MetricValue" android:text="@string/ui_label_bda050585a00"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/MetricLabel" android:text="@string/ui_label_a3d9193317ce"/><TextView android:id="@+id/viopAtr" style="@style/MetricValue" android:text="@string/ui_label_bda050585a00"/></LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_viop_terminal_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:weightSum="3">

                    <TextView android:id="@+id/viopActionLong" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_label_a97cab19f638" android:textColor="@color/green" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopActionShort" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_label_7309368d82e3" android:textColor="@color/red" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/viopActionWatch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/ui_label_eeda07647267" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_viop_terminal_card"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView style="@style/SectionTitle" android:text="@string/ui_label_c5785b4f583b" />
                        <TextView android:id="@+id/viopSummaryContract" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_viop_terminal_card"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView style="@style/SectionTitle" android:text="@string/ui_label_dd48d0455fdc" />
                        <TextView android:id="@+id/viopSummarySignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viopDepthSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_viop_terminal_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView style="@style/SectionTitle" android:text="@string/ui_label_0a0e56272237" />
                <TextView android:id="@+id/viopDepthBid" style="@style/Sub" android:layout_marginTop="14dp" android:text="@string/ui_label_9b86842810a5" />
                <TextView android:id="@+id/viopDepthAsk" style="@style/Sub" android:layout_marginTop="7dp" android:text="@string/ui_label_0f2ccf82eba8" />
                <TextView android:id="@+id/viopDepthSpread" style="@style/Sub" android:layout_marginTop="7dp" android:text="@string/ui_label_48981d0c766b" />
                <TextView android:id="@+id/viopDepthNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_label_530895931bc3" android:textColor="@color/text_muted" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viopSignalSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_viop_terminal_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView style="@style/SectionTitle" android:text="@string/ui_label_56471f6306d9" />
                <TextView android:id="@+id/viopSignalDirection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_label_4122c73ac156" android:textColor="@color/text_secondary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/viopSignalScore" style="@style/Sub" android:layout_marginTop="9dp" />
                <TextView android:id="@+id/viopSignalConfidence" style="@style/Sub" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/viopSignalRisk" style="@style/Sub" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/viopSignalReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viopContractSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_viop_terminal_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView style="@style/SectionTitle" android:text="@string/ui_label_9f6f33b35bd3" />
                <TextView android:id="@+id/viopContractBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
