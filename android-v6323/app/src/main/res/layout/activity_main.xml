<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- Compact brand/header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="@string/ui_label_29f5e0684482"
                    android:textColor="@color/green"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp" android:paddingEnd="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_label_c4a5ff79aaca"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="23sp"
                        android:autoSizeStepGranularity="1sp" 
                        android:textColor="@color/text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/ui_label_e2d492ce527a" android:maxLines="1" android:ellipsize="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVersionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_outline"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHeaderDateTime" android:maxLines="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHeaderSettings"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/ui_label_e5235a4a75e6"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp"
                    android:contentDescription="@string/ui_label_80ad54ad05fa" />
            </LinearLayout>

            <!-- Market strip -->
            <LinearLayout android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:id="@+id/marketBist100Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_e813df49d76e" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/marketBist100Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/marketBist100Change" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_17fb3ca9b2b3" android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/marketBist100Spark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/ui_label_bda050585a00" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/marketBist30Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_1008c76aa95f" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/marketBist30Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/marketBist30Change" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_17fb3ca9b2b3" android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/marketBist30Spark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/ui_label_bda050585a00" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/marketUsdCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_c23161dbe4a9" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/marketUsdValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/marketUsdChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_17fb3ca9b2b3" android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/marketUsdSpark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/ui_label_bda050585a00" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/marketGoldCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_15fd4325a418" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/marketGoldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/marketGoldChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_17fb3ca9b2b3" android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/marketGoldSpark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/ui_label_bda050585a00" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/marketViopCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_market_tile"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_4c33175f6d20" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/marketViopValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/ui_label_bda050585a00"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/marketViopChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_17fb3ca9b2b3" android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/marketViopSpark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/ui_label_bda050585a00" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary actions: 6 compact cards in 3 x 2 layout -->
            <LinearLayout android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/actionBist"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_action_neon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_844e7cbe15c3" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_6f333e6f8906" android:textColor="#DFF3FF" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionOpportunity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_action_cyan"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_42710bc3ee8f" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_004890e5caa1" android:textColor="#D8FBFF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/actionSignal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_action_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_177d681c67d6" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_38fb494dc5e7" android:textColor="#D9FFF0" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionViop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_action_neon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_648a1101a068" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_b9947a4b60e6" android:textColor="#FFF0DC" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/actionWatchlist"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_action_neon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_0ff945f7f393" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_7128e2b91829" android:textColor="#F2E9FF" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionNotifications"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_action_neon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_4d5b747c3a99" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_label_607c1e848120" android:textColor="#DFF3FF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- A8: main-screen cheap stock navigation; values remain in dedicated scanner -->
            <LinearLayout
                android:id="@+id/actionCheapStock"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_market_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ui_label_3bfa46db4d6f">
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_label_8416d7938c3d"
                    android:textColor="@color/green"
                    android:textSize="23sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="7dp"
                    android:orientation="vertical" android:paddingEnd="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/ui_label_6550d9217c08"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/ui_label_593195f441a7"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_label_7bb37df5cb36"
                    android:textColor="@color/green"
                    android:textSize="25sp" />
            </LinearLayout>

            <!-- Market summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="@string/ui_label_c77c3829943a"
                    android:textColor="@color/green"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp" android:paddingEnd="0dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_label_f8564107da40" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtMarketSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="@string/ui_label_8f3c174cf588" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnMarketDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/ui_label_5b681c1339f0"
                    android:textColor="@color/green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Today's opportunities -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_label_e6a342e9efb6" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnSeeAllOpportunities" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="@string/ui_label_78bfc4e4b5ff" android:textColor="@color/green" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/todayAllTab"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected_blue"
                        android:gravity="center"
                        android:text="@string/ui_label_965ab4e0b1ac"
                        android:textColor="@color/green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/todayLongTab"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:text="@string/ui_label_a8f3862b9630"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/todayShortTab"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:text="@string/ui_label_1bf63c90337e"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/todayEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    android:text="@string/ui_label_75b865da873c"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:id="@+id/todayHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
