<?xml version="1.0" ?>
<resources>
    <color name="market_bg">#031619</color>
    <color name="market_surface">#08282C</color>
    <color name="market_line">#17403F</color>
    <color name="market_mint">#00ED95</color>
    <color name="market_ink">#EDF8F4</color>
    <color name="market_muted">#8AA9A5</color>
    <color name="market_amber">#E8B95B</color>
    <style name="MarketChip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_market_chip</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/market_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MarketIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/market_muted</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="MarketText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/market_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="MarketSearch">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_market_input</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">textCapCharacters</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:textColor">@color/market_ink</item>
        <item name="android:textColorHint">@color/market_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawableStart">@drawable/ic_market_search</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
</resources>
