--- a/.github/workflows/build-670-touch-regression.yml
+++ b/.github/workflows/build-670-touch-regression.yml
@@ -0,0 +1,65 @@
+name: Build 670 Android 15 touch regression
+on:
+  workflow_dispatch:
+  push:
+    branches: ['fix/build670-touch']
+    paths: ['android-v6323/**', '.github/workflows/build-670-touch-regression.yml']
+permissions:
+  contents: read
+jobs:
+  verification:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - width: 320
+            scale: '1.0'
+          - width: 320
+            scale: '1.3'
+          - width: 411
+            scale: '1.0'
+          - width: 411
+            scale: '1.5'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: android-actions/setup-android@v3
+      - run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
+      - name: Enable emulator acceleration
+        run: |
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+      - name: Unit tests, lint and test compilation
+        working-directory: android-v6323
+        run: bash ./gradlew --no-daemon --max-workers=2 :app:testDiagnosticUnitTest :app:lintDiagnostic :app:assembleDiagnosticAndroidTest
+      - name: Real touch and chart tests on Android 15
+        uses: reactivecircus/android-emulator-runner@v2
+        with:
+          api-level: 35
+          arch: x86_64
+          profile: pixel_4
+          disable-animations: true
+          script: |
+            adb shell wm size ${{ matrix.width }}x800
+            adb shell wm density 160
+            adb shell settings put system font_scale ${{ matrix.scale }}
+            cd android-v6323
+            bash ./gradlew --no-daemon :app:connectedDiagnosticAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=tr.borsatakip.v5.ui.MarketTouchRuntimeTest,tr.borsatakip.v5.ui.Build670ChartRuntimeTest
+      - name: Build APK only after required tests pass
+        working-directory: android-v6323
+        run: bash ./gradlew --no-daemon :app:assembleDiagnostic
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: BUILD670-touch-${{ matrix.width }}-${{ matrix.scale }}
+          path: |
+            android-v6323/app/build/reports/
+            android-v6323/app/build/outputs/androidTest-results/
+            android-v6323/app/build/outputs/apk/diagnostic/*.apk
+          if-no-files-found: warn
